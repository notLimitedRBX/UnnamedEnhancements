{
  "name": "unnamed-desktop-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode app",
    "dev:downloader": "vite --mode downloader",
    "build": "npm run build:app",
    "build:app": "tsc && vite build --mode app",
    "build:downloader": "tsc && vite build --mode downloader",
    "tauri": "tauri",
    "downloader:dev": "tauri dev --config src-tauri/tauri.downloader.conf.json",
    "downloader:build": "tauri build --config src-tauri/tauri.downloader.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.3.4"
  }
}
