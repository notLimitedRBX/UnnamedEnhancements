{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unnamed Desktop App",
  "version": "0.1.0",
  "identifier": "com.notlimited.unnameddesktopapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:app",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unnamed Desktop App",
        "width": 1000,
        "height": 700
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
