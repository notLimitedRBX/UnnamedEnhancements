{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unnamed Enhancements Downloader",
  "version": "0.1.0",
  "identifier": "com.notlimited.unnamedenhancements.downloader",
  "build": {
    "beforeDevCommand": "npm run dev:downloader",
    "beforeBuildCommand": "npm run build:downloader",
    "devUrl": "http://localhost:5173/downloader.html",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unnamed Enhancements",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": false,
        "center": true,
        "url": "downloader.html"
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
